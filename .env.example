# Django
SECRET_KEY=replace-with-a-generated-secret-key
DEBUG=False

# SQLite (optional local database)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# PostgreSQL primary database
PDB_ENGINE=django.db.backends.postgresql
PDB_NAME=your_database_name
PDB_USER=your_postgres_username
PDB_PASSWORD=your_postgres_password
PDB_HOST=localhost
PDB_PORT=5432

# PostgreSQL replica database (optional)
RPDB_ENGINE=django.db.backends.postgresql
RPDB_NAME=your_replica_database_name
RPDB_USER=your_replica_username
RPDB_PASSWORD=your_replica_password
RPDB_HOST=localhost
RPDB_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379